+/// A learned selection is usable only if both sides are non-empty and the value
+/// isn't a word doubled by the old suffix bug (`vei` → `vেইvেই`). Genuinely
+/// reduplicated words keep a doubled key too (`kaka` → `কাকা`).
+fn is_valid_selection(key: &str, value: &str) -> bool {
+    !key.is_empty() && !value.is_empty() && (!is_doubled(value) || is_doubled(key))
+}
+
+fn is_doubled(text: &str) -> bool {
+    let half = text.len() / 2;
+    text.len() % 2 == 0 && text.is_char_boundary(half) && text[..half] == text[half..]
+}
+
+/// Writes the selections through a temporary file and a rename, so a crash or a
+/// full disk can never leave a truncated file behind.
+fn save_selections(
+    path: &Path,
+    selections: &HashMap<String, String, RandomState>,
+) -> std::io::Result<()> {
+    let json = serde_json::to_string(selections).map_err(std::io::Error::other)?;
+    let tmp = path.with_extension("json.tmp");
+    write(&tmp, json)?;
+    rename(&tmp, path).inspect_err(|_| {
+        let _ = std::fs::remove_file(&tmp);
+    })
+}
+
+type AutoCorrect = HashMap<String, String, RandomState>;
+
+/// Reads the user's auto correct file: its modification time, and its entries
+/// (`None` if the file can't be parsed). `None` if it can't be opened at all.
+fn load_autocorrect(path: &Path) -> Option<(SystemTime, Option<AutoCorrect>)> {
+    load_autocorrect_if_newer(path, None)
+}
+
+/// Like [`load_autocorrect`], but `None` unless the file is newer than `than`.
+fn load_autocorrect_if_newer(
+    path: &Path,
+    than: Option<SystemTime>,
+) -> Option<(SystemTime, Option<AutoCorrect>)> {
+    let modified = std::fs::metadata(path).and_then(|m| m.modified()).ok()?;
+    if than.is_some_and(|than| modified <= than) {
+        return None;
+    }
+    let entries = std::fs::read(path)
+        .ok()
+        .and_then(|bytes| serde_json::from_slice(&bytes).ok());
+    Some((modified, entries))
+}
